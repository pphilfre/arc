# Public runtime token (pk.) with Maps / Search / Directions access.
MAPBOX_ACCESS_TOKEN=pk.replace_with_your_public_mapbox_token
# Secret token (sk.) with DOWNLOADS:READ; CI/package downloads only. Never bundled.
MAPBOX_DOWNLOADS_TOKEN=sk.replace_with_your_downloads_read_token
ARC_BUNDLE_IDENTIFIER=dev.freddiephilpot.arc


# Attribution may only be hidden in a development build. Production always shows it.
ARC_BUILD_ENVIRONMENT=production
ARC_HIDE_MAP_ATTRIBUTION=false
